{
    "name": "chat",
    "version": "1.0.0",
    "private": true,
    "type": "module",
    "engines": {
        "node": ">=22.12"
    },
    "scripts": {
        "dev": "vite",
        "build": "npm run typecheck && vite build",
        "preview": "vite preview",
        "typecheck": "tsc -p . && tsc -p tsconfig.node.json",
        "lint": "eslint .",
        "lint:fix": "eslint . --fix",
        "prepare": "husky"
    },
    "lint-staged": {
        "*.{ts,tsx,mjs}": "eslint --fix"
    },
    "dependencies": {
        "@mantine/core": "^9.7.3",
        "@mantine/form": "^9.7.3",
        "@mantine/hooks": "^9.7.3",
        "@mantine/modals": "^9.7.3",
        "@mantine/notifications": "^9.7.3",
        "@tabler/icons-react": "^3.49.0",
        "clsx": "^2.1.1",
        "mantine-contextmenu": "^9.4.0",
        "react": "^19.3.1",
        "react-dom": "^19.3.1",
        "react-router": "^8.4.0"
    },
    "devDependencies": {
        "@eslint/js": "^9.39.5",
        "@stylistic/eslint-plugin": "^5.10.0",
        "@types/node": "^24.19.2",
        "@types/react": "^19.3.0",
        "@types/react-dom": "^19.3.0",
        "@vitejs/plugin-react": "^6.1.2",
        "eslint": "^9.39.5",
        "eslint-plugin-import": "^2.32.0",
        "eslint-plugin-perfectionist": "^5.12.1",
        "eslint-plugin-react-hooks": "^7.1.1",
        "eslint-plugin-react-refresh": "^0.5.7",
        "globals": "^17.13.0",
        "husky": "^9.1.7",
        "lint-staged": "^17.6.0",
        "postcss": "^8.5.31",
        "postcss-preset-mantine": "^1.18.0",
        "postcss-simple-vars": "^7.0.1",
        "typescript": "~6.0.3",
        "typescript-eslint": "^8.71.2",
        "vite": "^8.3.4"
    }
}
